# Copiez ce fichier vers .env. Remplacez les mots de passe avant tout usage.
# Gardez les identifiants simples (lettres/chiffres) ou encodez les caractères réservés dans DATABASE_URL.
DATABASE_URL="mysql://evtasks_app:CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD@127.0.0.1:3306/ev_tasks"
SHADOW_DATABASE_URL="mysql://evtasks_app:CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD@127.0.0.1:3306/ev_tasks_shadow"
MYSQL_USER=evtasks_app
MYSQL_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ROOT_PASSWORD_TOO
MYSQL_DATABASE=ev_tasks

HOST=0.0.0.0
PORT=3001
CORS_ORIGIN=http://localhost:5173
STORAGE_DIR=./var/media

# À renseigner uniquement pour créer le premier compte directeur après la migration.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_TITLE=Directeur
INITIAL_TEAM_NAME=Direction Marketing

# ---------------------------------------------------------------------------
# Exemple pour le SERVEUR DE PRODUCTION (VM) — voir DOCUMENTATION/03
# ---------------------------------------------------------------------------
# NODE_ENV=production
# HOST=127.0.0.1                      # le backend n'écoute qu'en local, Nginx est le seul point d'entrée
# PORT=3001
# CORS_ORIGIN=https://ev-tasks.exemple.local
# STORAGE_DIR=/var/lib/ev-tasks/media # chemin absolu, hors du dossier de l'application
# DATABASE_URL="mysql://evtasks_app:MOT_DE_PASSE@127.0.0.1:3306/ev_tasks"
# (SHADOW_DATABASE_URL n'est pas nécessaire en production : seul « migrate deploy » est utilisé)
